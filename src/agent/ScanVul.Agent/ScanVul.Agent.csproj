<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
        
        <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
        <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
        <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    </PropertyGroup>

    <ItemGroup Condition=" ('$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))) Or '$(Configuration)' == 'Debug' ">
        <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.0" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.6" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Karambolo.Extensions.Logging.File.Json" Version="3.6.3" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.6" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.6" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.6" />
        <PackageReference Include="System.Management.Automation" Version="7.6.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.6" />
    </ItemGroup>

    <ItemGroup>
      <None Update="scripts\packages.ps1">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\ScanVul.Contracts\ScanVul.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Services\PackageManagers\WingetCommandBuilder.cs">
        <DependentUpon>WingetPackageManager.cs</DependentUpon>
      </Compile>
    </ItemGroup>

    <Target Name="ZipPublish" AfterTargets="Publish">
        <ZipDirectory 
                Overwrite="true"
                SourceDirectory="$(PublishDir)"
                DestinationFile="$(PublishDir)\..\agent.zip" />
    </Target>
    
</Project>
